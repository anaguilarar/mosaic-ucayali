# machine-specific pipeline config (copy config.example.toml); intermediates live in its work_dir
pipeline/config.toml
__pycache__/
*.log
.env

# data files that go to Hugging Face, not GitHub (the SITE list in site/js/config.js is the
# source of truth; 91_publish_check.py reports the split). Tiles are ignored except the small
# OSM basemap served from the repo.
data/tiles/*.pmtiles
!data/tiles/osm_basemap.pmtiles
!data/tiles/terrain.pmtiles
!data/tiles/s2_rgb.pmtiles
data/query/
data/fire/
*.tif
# the climate stacks are small and served from the repo (SITE list)
!data/climate/**/*.tif
*.h5
*.parquet
